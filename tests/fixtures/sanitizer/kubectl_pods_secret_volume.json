{
    "apiVersion": "v1",
    "items": [
        {
            "apiVersion": "v1",
            "kind": "Pod",
            "metadata": {
                "name": "argocd-repo-server-5d8f9c7b6d-x2k4p",
                "namespace": "argocd"
            },
            "spec": {
                "containers": [
                    {
                        "env": [
                            {
                                "name": "ARGOCD_REDIS_PASSWORD",
