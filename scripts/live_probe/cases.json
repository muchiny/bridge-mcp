{
  "vars": {
    "chart_multi": "/home/muchini/media-stack-k8s/charts/plex",
    "chart_single": "/home/muchini/media-stack-k8s/charts/backup"
  },
  "cases": [
    {"id": "J1", "owner": "base", "tool": "ssh_k8s_get",
     "args": {"resource": "pods", "namespace": "argocd", "output": "json", "jq_filter": ".items[] | [.metadata.name, .status.phase]", "output_format": "tsv"},
     "expect": "re=^argocd-\\S+\\tRunning$"},
    {"id": "J2", "owner": "base", "tool": "ssh_k8s_get",
     "args": {"resource": "pods", "all_namespaces": true, "output": "json", "max_output": 0},
     "expect": "json"},
    {"id": "J3", "owner": "base", "tool": "ssh_k8s_version",
     "args": {"jq_filter": ".serverVersion.gitVersion"},
     "expect": "re=^\"v1\\."},
    {"id": "J4", "owner": "lane-b", "tool": "ssh_k8s_get",
     "args": {"resource": "pods", "all_namespaces": true, "output": "json", "jq_filter": ".items[].metadata.name", "limit": 2},
     "expect": "lines=2"},
    {"id": "J5", "owner": "lane-b", "tool": "ssh_k8s_get",
     "args": {"resource": "pods", "all_namespaces": true, "output": "json", "limit": 2, "max_output": 0},
     "expect": "count=\"kind\": \"Pod\":2"},
    {"id": "J6", "owner": "base", "tool": "ssh_ls",
     "args": {"path": "/etc", "jq_filter": ".[] | [.name, .size]", "output_format": "tsv"},
     "expect": "re=^\\S+\\t\\d+$"},
    {"id": "J7", "owner": "lane-b", "tool": "ssh_ls",
     "args": {"path": "/etc", "jq_filter": ".[] | [.name]", "output_format": "tsv", "limit": 3},
     "expect": "lines=3"},
    {"id": "J8", "owner": "lane-b", "tool": "ssh_ls",
     "args": {"path": "/etc", "columns": ["name"]},
     "expect": "error=columns"},
    {"id": "Y1", "owner": "lane-b", "tool": "ssh_k8s_get",
     "args": {"resource": "namespaces", "name": "argocd", "output": "yaml"},
     "expect": "first=apiVersion: v1"},
    {"id": "Y2", "owner": "lane-b", "tool": "ssh_k8s_get",
     "args": {"resource": "pods", "namespace": "argocd", "output": "yaml", "max_output": 0},
     "expect": "re=^      secret:\\n        defaultMode: 420$"},
    {"id": "Y3", "owner": "lane-b", "tool": "ssh_k8s_get",
     "args": {"resource": "namespaces", "name": "argocd", "output": "yaml", "yq_filter": ".metadata.name"},
     "expect": "eq=\"argocd\""},
    {"id": "Y4", "owner": "lane-b", "tool": "ssh_k8s_get",
     "args": {"resource": "pods", "namespace": "argocd", "output": "yaml", "yq_filter": ".items[] | [.metadata.name]", "output_format": "tsv", "limit": 2},
     "expect": "lines=2"},
    {"id": "Y5", "owner": "lane-b", "tool": "ssh_k8s_get",
     "args": {"resource": "pods", "namespace": "argocd", "output": "yaml", "limit": 2, "max_output": 0},
     "expect": "count=  kind: Pod:2"},
    {"id": "H1", "owner": "lane-b", "tool": "ssh_helm_template",
     "args": {"release": "t", "chart": "${chart_multi}", "yq_filter": ".kind", "output_format": "tsv"},
     "expect": "lines>=4"},
    {"id": "H2", "owner": "lane-b", "tool": "ssh_helm_template",
     "args": {"release": "t", "chart": "${chart_multi}", "yq_filter": ".kind", "output_format": "tsv", "limit": 2},
     "expect": "lines=2"},
    {"id": "H3", "owner": "lane-b", "tool": "ssh_helm_template",
     "args": {"release": "t", "chart": "${chart_multi}", "limit": 2, "max_output": 0},
     "expect": "count=\nkind: :2"},
    {"id": "H4", "owner": "base", "tool": "ssh_helm_template",
     "args": {"release": "t", "chart": "${chart_single}", "yq_filter": "[.kind, .metadata.name]", "output_format": "tsv"},
     "expect": "eq=CronJob\tt-backup"},
    {"id": "T1", "owner": "base", "tool": "ssh_k8s_get",
     "args": {"resource": "pods", "all_namespaces": true, "columns": ["NAMESPACE", "NAME", "STATUS"], "limit": 3},
     "expect": "lines=4"},
    {"id": "T2", "owner": "base", "tool": "ssh_k8s_top",
     "args": {"resource_type": "nodes"},
     "expect": "re=^NAME\\t"},
    {"id": "S1", "owner": "base", "tool": "ssh_exec", "yes": true, "paths": ["cli"],
     "args": {"command": "printf '%s\\n' '{\"secret\": {\"secretName\": \"tls\"}}' '{\"credential\": 5, \"name\": \"tmpl\"}' '{\"token\": true}'"},
     "expect": "eq={\"secret\": {\"secretName\": \"tls\"}}\\n{\"credential\": 5, \"name\": \"tmpl\"}\\n{\"token\": true}"},
    {"id": "S2", "owner": "base", "tool": "ssh_exec", "yes": true, "paths": ["cli"],
     "args": {"command": "printf '%s\\n' '{\"password\": \"hunter2\"}' '{\"Credentials\": {\"SecretAccessKey\": \"wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY\", \"Expiration\": \"2026\"}}'"},
     "expect": "eq={\"password\": \"[REDACTED]\"}\\n{\"Credentials\": {\"SecretAccessKey\": \"[REDACTED]\", \"Expiration\": \"2026\"}}"},
    {"id": "S3", "owner": "lane-a", "tool": "ssh_exec", "yes": true, "paths": ["cli"],
     "args": {"command": "printf '%s\\n' 'password: hunter2' 'token: Z2hwX2FiYzEyMzQ1Njc4OTBhYmNkZWZnaGlqa2xtbm9w' 'AWS_SESSION_TOKEN: FwoGZXIvYXdzEBYaDHc3RVhBTVBMRVRPS0VOEXAMPLE'"},
     "expect": "eq=password: [REDACTED]\\ntoken: [REDACTED]\\nAWS_SESSION_TOKEN: [REDACTED]"},
    {"id": "S4", "owner": "lane-a", "tool": "ssh_exec", "yes": true, "paths": ["cli"],
     "args": {"command": "printf '%s\\n' 'password={hunter2}' 'password=[hunter2]' '{\"password\": {\"nested\": \"x\"}}'"},
     "expect": "eq=password=[REDACTED]\\npassword=[REDACTED]\\n{\"password\": {\"nested\": \"x\"}}"},
    {"id": "S5", "owner": "base", "tool": "ssh_exec", "yes": true, "paths": ["cli"],
     "args": {"command": "printf '%s\\n' 'secret:' '  secretName: tls' 'token: enabled' 'secretName: argocd-repo-server-tls'"},
     "expect": "eq=secret:\\n  secretName: tls\\ntoken: enabled\\nsecretName: argocd-repo-server-tls"},
    {"id": "S6", "owner": "lane-a", "tool": "ssh_exec", "yes": true, "paths": ["cli"],
     "args": {"command": "printf '%s\\n' 'docker login -u bob -p' 'next-line' '--vault-password-file' '/etc/passwd' 'VAULT_TOKEN=hvs.CAESIJ1234567890abcdefghij'"},
     "expect": "eq=docker login -u bob -p\\nnext-line\\n--vault-password-file\\n/etc/passwd\\nVAULT_TOKEN=[VAULT_TOKEN_REDACTED]"}
  ]
}
