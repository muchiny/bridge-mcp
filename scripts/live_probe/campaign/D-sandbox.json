{"vars": {"chart_single": "/home/muchini/media-stack-k8s/charts/backup",
          "cm": "apiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: bridge-campaign-probe\n  namespace: default\ndata:\n  probe: campaign\n",
          "role": "apiVersion: rbac.authorization.k8s.io/v1\nkind: Role\nmetadata:\n  name: bridge-campaign-probe\n  namespace: default\nrules:\n- apiGroups: [\"\"]\n  resources: [\"configmaps\"]\n  verbs: [\"get\"]\n"},
 "cases": [
  {"id": "D01", "owner": "campaign", "tool": "ssh_exec", "yes": true, "paths": ["cli"], "args": {"command": "mkdir -p /tmp/bridge-campaign && echo made"}, "expect": "eq=made"},
  {"id": "D02", "owner": "campaign", "tool": "ssh_file_write", "yes": true, "paths": ["cli"], "args": {"path": "/tmp/bridge-campaign/a.txt", "content": "alpha\n"}, "expect": "ok"},
  {"id": "D03", "owner": "campaign", "tool": "ssh_file_read", "paths": ["cli"], "args": {"path": "/tmp/bridge-campaign/a.txt"}, "expect": "eq=alpha"},
  {"id": "D04", "owner": "campaign", "tool": "ssh_file_write", "yes": true, "paths": ["cli"], "args": {"path": "/tmp/bridge-campaign/a.txt", "content": "beta\n", "append": true}, "expect": "ok"},
  {"id": "D05", "owner": "campaign", "tool": "ssh_file_read", "paths": ["cli"], "args": {"path": "/tmp/bridge-campaign/a.txt"}, "expect": "eq=alpha\\nbeta"},
  {"id": "D06", "owner": "campaign", "tool": "ssh_files_write", "yes": true, "paths": ["cli"], "args": {"files": [{"remote_path": "/tmp/bridge-campaign/b.txt", "content": "b\n"}, {"remote_path": "/tmp/bridge-campaign/c.txt", "content": "c\n"}]}, "expect": "ok"},
  {"id": "D07", "owner": "campaign", "tool": "ssh_file_chmod", "paths": ["cli"], "args": {"path": "/tmp/bridge-campaign/a.txt", "mode": "600"}, "expect": "ok"},
  {"id": "D08", "owner": "campaign", "tool": "ssh_file_stat", "paths": ["cli"], "args": {"path": "/tmp/bridge-campaign/a.txt"}, "expect": "re=600|-rw-------"},
  {"id": "D09", "owner": "campaign", "tool": "ssh_file_chown", "paths": ["cli"], "args": {"path": "/tmp/bridge-campaign/a.txt", "owner": "muchini"}, "expect": "ok"},
  {"id": "D10", "owner": "campaign", "tool": "ssh_file_patch", "yes": true, "paths": ["cli"], "args": {"target_file": "/tmp/bridge-campaign/a.txt", "patch_content": "--- a.txt\n+++ a.txt\n@@ -1,2 +1,2 @@\n alpha\n-beta\n+gamma\n", "dry_run": true}, "expect": "ok"},
  {"id": "D11", "owner": "campaign", "tool": "ssh_file_read", "paths": ["cli"], "args": {"path": "/tmp/bridge-campaign/a.txt"}, "expect": "eq=alpha\\nbeta"},
  {"id": "D12", "owner": "campaign", "tool": "ssh_file_patch", "yes": true, "paths": ["cli"], "args": {"target_file": "/tmp/bridge-campaign/a.txt", "patch_content": "--- a.txt\n+++ a.txt\n@@ -1,2 +1,2 @@\n alpha\n-beta\n+gamma\n"}, "expect": "ok"},
  {"id": "D13", "owner": "campaign", "tool": "ssh_file_read", "paths": ["cli"], "args": {"path": "/tmp/bridge-campaign/a.txt"}, "expect": "eq=alpha\\ngamma"},
  {"id": "D14", "owner": "campaign", "tool": "ssh_file_diff", "paths": ["cli"], "args": {"file1": "/tmp/bridge-campaign/a.txt", "file2": "/tmp/bridge-campaign/b.txt"}, "expect": "ok"},
  {"id": "D15", "owner": "campaign", "tool": "ssh_upload", "paths": ["cli"], "args": {"local_path": "/tmp/bridge-campaign-local/up.txt", "remote_path": "/tmp/bridge-campaign/up.txt"}, "expect": "ok"},
  {"id": "D16", "owner": "campaign", "tool": "ssh_file_read", "paths": ["cli"], "args": {"path": "/tmp/bridge-campaign/up.txt"}, "expect": "eq=up"},
  {"id": "D17", "owner": "campaign", "tool": "ssh_upload", "paths": ["cli"], "args": {"local_path": "/tmp/bridge-campaign-local/up.txt", "remote_path": "/tmp/bridge-campaign/up.txt", "mode": "fail_if_exists"}, "expect": "error="},
  {"id": "D18", "owner": "campaign", "tool": "ssh_download", "paths": ["cli"], "args": {"remote_path": "/tmp/bridge-campaign/a.txt", "local_path": "/tmp/bridge-campaign-local/down.txt"}, "expect": "ok"},
  {"id": "D19", "owner": "campaign", "tool": "ssh_upload", "paths": ["cli"], "args": {"local_path": "/tmp/bridge-campaign-local/tpl.txt", "remote_path": "/tmp/bridge-campaign/tpl.txt"}, "expect": "ok"},
  {"id": "D20", "owner": "campaign", "tool": "ssh_file_template", "paths": ["cli"], "args": {"template_path": "/tmp/bridge-campaign/tpl.txt", "output_path": "/tmp/bridge-campaign/out.txt", "variables": {"NAME": "campaign"}}, "expect": "ok"},
  {"id": "D21", "owner": "campaign", "tool": "ssh_file_read", "paths": ["cli"], "args": {"path": "/tmp/bridge-campaign/out.txt"}, "expect": "eq=HELLO=campaign"},
  {"id": "D22", "owner": "env", "tool": "ssh_sync", "paths": ["cli"], "args": {"source": "/tmp/bridge-campaign-local/", "destination": "/tmp/bridge-campaign/sync/", "direction": "upload"}, "expect": "ok"},
  {"id": "D23", "owner": "campaign", "tool": "ssh_backup_create", "paths": ["cli"], "args": {"source_paths": ["/tmp/bridge-campaign/a.txt", "/tmp/bridge-campaign/b.txt"], "output_file": "/tmp/bridge-campaign/bk.tar.gz", "compress": "gzip"}, "expect": "ok"},
  {"id": "D24", "owner": "campaign", "tool": "ssh_backup_list", "paths": ["cli"], "args": {"archive_file": "/tmp/bridge-campaign/bk.tar.gz"}, "expect": "re=a\\.txt"},
  {"id": "D25", "owner": "campaign", "tool": "ssh_backup_verify", "paths": ["cli"], "args": {"archive": "/tmp/bridge-campaign/bk.tar.gz"}, "expect": "ok"},
  {"id": "D26", "owner": "campaign", "tool": "ssh_backup_snapshot", "paths": ["cli"], "args": {"paths": "/tmp/bridge-campaign/a.txt", "label": "bridge-campaign"}, "expect": "re=/tmp/.*bridge-campaign.*\\.tar\\.gz"},
  {"id": "D27", "owner": "campaign", "tool": "ssh_k8s_apply", "paths": ["cli"], "args": {"manifest": "${cm}", "namespace": "default", "dry_run": "server"}, "expect": "re=dry run"},
  {"id": "D28", "owner": "campaign", "tool": "ssh_k8s_get", "paths": ["cli"], "args": {"resource": "configmap", "name": "bridge-campaign-probe", "namespace": "default"}, "expect": "error="},
  {"id": "D29", "owner": "campaign", "tool": "ssh_k8s_create_configmap", "paths": ["cli"], "args": {"name": "bridge-campaign-probe", "namespace": "default", "from_literal": {"probe": "campaign"}, "dry_run": "server"}, "expect": "re=dry run"},
  {"id": "D30", "owner": "campaign", "tool": "ssh_k8s_auth_reconcile", "paths": ["cli"], "args": {"manifest": "${role}", "dry_run": true}, "expect": "ok"},
  {"id": "D31", "owner": "campaign", "tool": "ssh_k8s_get", "paths": ["cli"], "args": {"resource": "role", "name": "bridge-campaign-probe", "namespace": "default"}, "expect": "error="},
  {"id": "D32", "owner": "campaign", "tool": "ssh_helm_install", "paths": ["cli"], "args": {"release": "bridge-campaign-probe", "chart": "${chart_single}", "namespace": "default", "dry_run": "server"}, "expect": "re=pending-install"},
  {"id": "D33", "owner": "campaign", "tool": "ssh_helm_upgrade", "paths": ["cli"], "args": {"release": "bridge-campaign-nope", "chart": "${chart_single}", "namespace": "default", "dry_run": "server"}, "expect": "error="},
  {"id": "D34", "owner": "campaign", "tool": "ssh_k8s_rollout", "paths": ["cli"], "args": {"action": "status", "resource": "deployment/argocd-server", "namespace": "argocd"}, "expect": "re=successfully rolled out"},
  {"id": "D35", "owner": "campaign", "tool": "ssh_k8s_rollout", "paths": ["cli"], "args": {"action": "history", "resource": "deployment/argocd-server", "namespace": "argocd"}, "expect": "re=REVISION"},
  {"id": "D36", "owner": "campaign", "tool": "ssh_k8s_exec", "paths": ["cli"], "args": {"pod": "argocd-application-controller-0", "namespace": "argocd", "command": "id"}, "expect": "re=uid="},
  {"id": "D37", "owner": "campaign", "tool": "ssh_k8s_exec", "paths": ["cli"], "args": {"pod": "argocd-application-controller-0", "namespace": "argocd", "argv": ["cat", "/etc/hostname"]}, "expect": "re=argocd-application-controller-0"},
  {"id": "D38", "owner": "env", "tool": "ssh_git_clone", "paths": ["cli"], "args": {"url": "file:///home/muchini/media-stack-k8s", "destination": "/tmp/bridge-campaign/repo", "depth": 1}, "expect": "ok"},
  {"id": "D39", "owner": "env", "tool": "ssh_git_branch", "paths": ["cli"], "args": {"path": "/tmp/bridge-campaign/repo", "action": "list"}, "expect": "ok"},
  {"id": "D40", "owner": "env", "tool": "ssh_git_pull", "paths": ["cli"], "args": {"path": "/tmp/bridge-campaign/repo", "ff_only": true}, "expect": "ok"},
  {"id": "D41", "owner": "campaign", "tool": "ssh_k3s_ctr_images", "paths": ["cli"], "args": {"action": "ls", "sudo": true}, "expect": "ok"},
  {"id": "D42", "owner": "campaign", "tool": "ssh_pty_exec", "paths": ["cli"], "args": {"command": "echo pty-ok"}, "expect": "re=pty-ok"},
  {"id": "D43", "owner": "campaign", "tool": "ssh_exec_multi", "paths": ["cli"], "args": {"hosts": ["raspberry"], "command": "hostname"}, "expect": "re=server"},
  {"id": "D44", "owner": "campaign", "tool": "ssh_host_tags", "paths": ["cli"], "args": {"action": "list"}, "expect": "ok"},
  {"id": "D90", "owner": "campaign", "tool": "ssh_exec", "yes": true, "paths": ["cli"], "args": {"command": "rm -r /tmp/bridge-campaign && echo removed"}, "expect": "eq=removed"},
  {"id": "D91", "owner": "campaign", "tool": "ssh_ls", "paths": ["cli"], "args": {"path": "/tmp/bridge-campaign"}, "expect": "error="}
 ]}
