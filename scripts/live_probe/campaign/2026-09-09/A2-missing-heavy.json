{
  "vars": {
    "SANDBOX": "/tmp/bridge-test-0909",
    "SANDBOX_LOCAL": "/tmp/bridge-test-0909-local",
    "LOCAL_OUT": "/home/muchini/bmcp-test-0909/.superpowers/campaign/2026-09-09/out",
    "NS": "bridge-test",
    "SBXUSER": "btest0909",
    "SBXGROUP": "btestgrp0909",
    "CRON_MARK": "BRIDGE_TEST_0909",
    "UNIT": "bridge-test-0909",
    "SLEEPPID": "",
    "NS_MANIFEST": "/tmp/bridge-test-0909/ns.yaml",
    "PAUSE_IMAGE": "",
    "BUSYBOX_OK": "",
    "UFW_ABSENT": "true",
    "HAD_CRONTAB": "true",
    "BT_CID": ""
  },
  "cases": [
    {
      "id": "A401",
      "owner": "campaign",
      "tool": "ssh_benchmark",
      "args": {
        "bench_type": "memory"
      },
      "expect": "ok"
    },
    {
      "id": "A402",
      "owner": "campaign",
      "tool": "ssh_network_capture",
      "args": {
        "interface": "lo",
        "count": 1,
        "filter": "port 65432",
        "timeout_seconds": 20
      },
      "expect": "re=\\[exit:"
    },
    {
      "id": "A403",
      "owner": "campaign",
      "tool": "ssh_helm_dependency",
      "args": {
        "chart_path": "/home/muchini/media-stack-k8s/charts/plex",
        "subcommand": "list"
      },
      "expect": "ok"
    },
    {
      "id": "A404",
      "owner": "campaign",
      "tool": "ssh_helm_pull",
      "args": {
        "chart": "bmcp-nope/nothing",
        "destination": "/tmp/bridge-test-0909"
      },
      "expect": "re=\\[exit:"
    },
    {
      "id": "A405",
      "owner": "campaign",
      "tool": "ssh_helm_repo_add",
      "args": {
        "name": "bmcp-nope",
        "url": "bmcp-nope://invalid"
      },
      "expect": "error=repo URL must start with https://, http://, or oci://"
    },
    {
      "id": "A406",
      "owner": "campaign",
      "tool": "ssh_helm_repo_update",
      "args": {
        "repos": [
          "bmcp-nope"
        ]
      },
      "expect": "re=\\[exit:"
    },
    {
      "id": "A407",
      "owner": "campaign",
      "tool": "ssh_helm_test",
      "args": {
        "release": "bmcp-nope-release",
        "namespace": "bridge-test"
      },
      "expect": "re=\\[exit:"
    },
    {
      "id": "A408",
      "owner": "campaign",
      "tool": "ssh_k3s_etcd_snapshot_save",
      "args": {
        "dir": "/tmp",
        "name": "bmcp-nope-never-created"
      },
      "expect": "re=\\[exit:"
    },
    {
      "id": "A409",
      "owner": "campaign",
      "tool": "ssh_pkg_install",
      "args": {
        "package": "bmcp-nonexistent-package-probe"
      },
      "expect": "re=\\[exit:"
    },
    {
      "id": "A410",
      "owner": "campaign",
      "tool": "ssh_tunnel_create",
      "args": {
        "local_port": 45623,
        "remote_host": "127.0.0.1",
        "remote_port": 22
      },
      "expect": "re=tunnel-raspberry-45623-22"
    }
  ]
}